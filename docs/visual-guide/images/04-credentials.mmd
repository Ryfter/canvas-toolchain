        U4[Cloud Q&A embeddings]
        U5[Live topic-currency search]
    end

    K1 --> U1
    K2 --> U2
    K3 --> U3
    K4 --> U4
    K5 --> U5

    classDef free fill:#E6F6F3,stroke:#1B998B,stroke-width:1.5px,color:#0F5A4F;
