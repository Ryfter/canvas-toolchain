{
  "name": "@canvas-toolchain/canvas-design-studio",
  "license": "MIT",
  "version": "2.2.1",
  "description": "Canvas Design Studio — MCP server for generating, validating, and publishing Canvas LMS pages",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "canvas-toolchain-design-studio": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/templates','dist/templates',{recursive:true})\"",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@canvas-toolchain/shared-llm": "2.2.1",
    "@canvas-toolchain/shared-types": "2.2.1",
    "@inquirer/prompts": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "axe-core": "^4.12.1",
    "cheerio": "^1.2.0",
    "color": "^4.2.3",
    "jsdom": "^29.1.1",
    "juice": "^11.1.1",
    "yaml": "^2.9.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/color": "^3.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryfter/canvas-toolchain.git",
    "directory": "packages/canvas-design-studio"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "src/kb",
    "docs/setup-worksheet.md",
    "data"
  ]
}
