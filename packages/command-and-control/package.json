{
  "name": "@canvas-toolchain/command-and-control",
  "license": "MIT",
  "version": "2.2.1",
  "description": "Command & Control — MCP server that orchestrates the professor toolset with task-aware model routing",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "canvas-toolchain-dashboard": "dist/cli/dashboard.js",
    "canvas-toolchain-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/recommended-models.fallback.md','dist/recommended-models.fallback.md')\"",
    "dev": "tsx src/index.ts",
    "smoke:integration": "tsx scripts/smoke-integration.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@canvas-toolchain/canvas-design-studio": "2.2.1",
    "@canvas-toolchain/curriculum-intelligence": "2.2.1",
    "@canvas-toolchain/module-contract": "2.2.1",
    "@canvas-toolchain/module-group-builder": "2.2.1",
    "@canvas-toolchain/module-oral-assessment": "2.2.1",
    "@canvas-toolchain/module-peerassessment": "2.2.1",
    "@canvas-toolchain/module-roster": "2.2.1",
    "@canvas-toolchain/module-video": "2.2.1",
    "@canvas-toolchain/shared-llm": "2.2.1",
    "@canvas-toolchain/shared-types": "2.2.1",
    "@llamaindex/liteparse": "^2.0.5",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "better-sqlite3": "^12.10.0",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryfter/canvas-toolchain.git",
    "directory": "packages/command-and-control"
  },
  "files": [
    "dist",
    "data"
  ]
}
